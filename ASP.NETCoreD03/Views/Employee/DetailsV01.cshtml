@model Employee

<div class="card" style="width: 18rem;">
    <div class="card-body">
        <h5 class="card-title">Employee Id: @Model.Id</h5>
        <h6 class="card-subtitle mb-2 text-muted">Employee Name: @Model.Name</h6>
        <h6 class="card-subtitle mb-2 text-muted">Employee Age: @Model.Age</h6>
        <h6 class="card-subtitle mb-2 text-muted">Employee Salary: @Model.Salary</h6>
        <h6 class="card-subtitle mb-2 text-muted">Employee Department: @Model.Department!.Name</h6>
        <a href="~/Employee/IndexV01" class="btn btn-outline-secondary">Back</a>
    </div>
</div>